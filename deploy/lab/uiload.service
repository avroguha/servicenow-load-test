[Unit]
Description=ServiceNow UI load test (controller, mock identity provider, local workers)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@APP_DIR@
# 0.0.0.0: reachable on the lab network and the tailnet. Plain HTTP - keep it off the internet.
Environment=UILOAD_HOST=0.0.0.0
Environment=UILOAD_PORT=8787
Environment=UILOAD_DATA=@DATA_DIR@
ExecStart=/usr/local/bin/node src/server.js
Restart=on-failure
# Stopping the service during a run stops the load and cleans the instance first.
KillMode=mixed
TimeoutStopSec=200

[Install]
WantedBy=multi-user.target
