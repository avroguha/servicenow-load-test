# Office deployment:   docker compose --env-file work.env up --build -d
#
# The values below are PLACEHOLDERS on avro.com. On the work machine replace
# them with the site's real registry, package mirror and proxy - and do not
# commit that edit (git update-index --skip-worktree work.env).
# This file holds no secret. A registry token goes in the shell for one command:
#   NPM_TOKEN=... docker compose --env-file work.env up --build -d

# ---- where things come from ----
# The site's Docker registry prefix, WITH the trailing slash. The base image
# (the official Node image from Docker Hub) is pulled through it.
IMAGE_REGISTRY=registry.avro.com/
# The site's mirror of the Debian package archive (for the browser package), and
# of Debian security updates. Leave one EMPTY to use the image's own source for
# it, which then goes through the proxy below.
APT_MIRROR=https://packages.avro.com/debian/
APT_SECURITY_MIRROR=
NPM_REGISTRY=https://packages.avro.com/api/npm/npm-public/
HTTP_PROXY=http://proxy.avro.com:8080
HTTPS_PROXY=http://proxy.avro.com:8080
NO_PROXY=localhost,127.0.0.1,.avro.com,avro.com
# Leave empty unless the proxy intercepts TLS; then: base64 -w0 site-ca.pem
CA_BUNDLE_B64=

# ---- this deployment ----
# Settings, results and the HTTPS certificate live here, outside the code folder.
STATE_DIR=../uiload-state
# The name people type in the browser.
PUBLIC_HOST=loadtest.avro.com
# More names or addresses for the first, self-signed certificate (comma separated), or empty.
TLS_NAMES=
HTTPS_PORT=443
HTTP_PORT=80
