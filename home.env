# Home lab deployment:   docker compose --env-file home.env up --build -d
#
# Public registries, no proxy. The EMPTY lines must stay: compose requires every
# key, and empty is how this file says "none".
# This file holds no secret.

# ---- where things come from ----
IMAGE_REGISTRY=
APT_MIRROR=
NPM_REGISTRY=https://registry.npmjs.org/
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
CA_BUNDLE_B64=

# ---- this deployment ----
STATE_DIR=../uiload-state
PUBLIC_HOST=192.168.5.46
TLS_NAMES=uiload,uiload.lan
HTTPS_PORT=443
HTTP_PORT=80

# ---- only for a worker on another machine (docker-compose.worker.yml) ----
WORKER_CONTROLLER_URL=https://192.168.5.46
WORKER_DIR=../uiload-worker
WORKER_CAPACITY=10
WORKER_NAME=
WORKER_ACCEPT_ANY_CERTIFICATE=1
